{%- comment -%}
  NED — Product-page per-warehouse stock (LIVE fetch, real-time).

  The total stock number your theme already shows is native/real-time; Shopify just
  doesn't expose the per-WAREHOUSE split to Liquid. This snippet fetches that split
  live from the freight app on page load, so it's real-time too.

  Trade customers (logged in, carrying the trade tag) see exact per-warehouse levels
  + incoming; retail/anonymous see only a location badge (no numbers). The trade flag
  is set in Liquid (server-side) from customer.tags; display gating is client-side.
  NOTE: the endpoint returns the raw split to any caller (display-only gating), which
  is the accepted trade-off for real-time without an app proxy.

  SETUP
  1. Paste this into the product template where the stock line should appear.
  2. If your trade tag isn't 'wholesale', change TRADE_TAG below.
  3. If the freight app domain changes, update STOCK_URL.
{%- endcomment -%}

{%- assign TRADE_TAG = 'wholesale' -%}
{%- assign is_trade = false -%}
{%- if customer and customer.tags contains TRADE_TAG -%}{%- assign is_trade = true -%}{%- endif -%}

<div id="ned-wh-stock" data-product-id="{{ product.id }}" style="margin:10px 0;font-size:14px;"></div>
<script>
(function () {
  var STOCK_URL = "https://ned-freight-app.onrender.com/api/product-stock";
  var TRADE = {{ is_trade | json }};
  var el = document.getElementById("ned-wh-stock");
  if (!el) return;
  var productId = el.getAttribute("data-product-id");
  var byVariant = null;

  function currentVariantId() {
    var u = new URLSearchParams(location.search).get("variant");
    if (u) return String(u);
    var input = document.querySelector('form[action*="/cart/add"] [name="id"]');
    return input ? String(input.value) : null;
  }
  function fmtDate(d) {
    if (!d) return "";
    try { return new Date(d).toLocaleDateString("en-NZ", { day: "numeric", month: "short", year: "numeric" }); }
    catch (e) { return d; }
  }
  function render() {
    if (!byVariant) return;
    var r = byVariant[currentVariantId()];
    if (!r) { el.innerHTML = ""; return; }
    if (TRADE) {
      var line = "In stock — Auckland: <strong>" + (r.akl || 0) + "</strong> &nbsp;·&nbsp; Christchurch: <strong>" + (r.chch || 0) + "</strong>";
      if (r.incoming) {
        line += '<div style="color:#8a6d3b;margin-top:4px;">' + r.incoming + " incoming"
              + (r.incoming_warehouse ? " to " + r.incoming_warehouse : "")
              + (r.arrival_date ? " (arriving " + fmtDate(r.arrival_date) + ")" : "") + "</div>";
      }
      el.innerHTML = "<div>" + line + "</div>";
    } else {
      var label = { "AKL & CHCH": "Auckland & Christchurch", "AKL": "Auckland", "CHCH": "Christchurch" }[r.location];
      el.innerHTML = label ? "<div>In stock — ships from <strong>" + label + "</strong></div>" : "";
    }
  }

  fetch(STOCK_URL + "?product_id=" + encodeURIComponent(productId))
    .then(function (res) { return res.ok ? res.json() : null; })
    .then(function (data) {
      if (!data || !data.variants) return;
      byVariant = {};
      data.variants.forEach(function (v) { byVariant[String(v.variant_id)] = v; });
      render();
    })
    .catch(function () { /* fail silent — never break the PDP */ });

  document.addEventListener("change", function (e) {
    if (e.target && (e.target.name === "id" || (e.target.matches && e.target.matches('[name^="options"]')))) setTimeout(render, 50);
  });
  window.addEventListener("popstate", render);
})();
</script>
